# Gmail SMTP Settings

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME=Your Website Name

MAIL_PRIMARY_COLOR=#0d6efd

MAIL_LOGO=https://your-domain.com/logo.png

MAIL_SIGNATURE=The Your_Project Team

# Application URL
APP_URL=your website url

PRIVATE_MAILER_LICENSE=your-license-key